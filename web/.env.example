# 前端與 API 都在 Vercel 同一個網站時留空即可。
# 只有 API 放在別的網域時才填（不含 /api 與結尾斜線）。
VITE_API_BASE=

# 本機 npm run dev 測試爬蟲上傳時使用（Vercel 上請在 Environment Variables 設定）
CRAWL_TOKEN=

# 推播（Vercel 上請在 Environment Variables 設定）
# 產生金鑰：cd web && npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 外部排程（cron-job.org）呼叫 /api/notify 用的密鑰
NOTIFY_TOKEN=
